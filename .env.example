# Required for the admin photo manager. Use a unique random secret of at least 16 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_ACCESS_CODE=

# Connect a public Vercel Blob store to persist product images and photo metadata.
# Vercel adds this variable when you connect the store to the project.
BLOB_READ_WRITE_TOKEN=
